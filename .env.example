# Use your local PostgreSQL credentials. Do not commit actual credentials.
DATABASE_URL=postgresql+psycopg://recsyslab:CHANGE_ME@127.0.0.1:5432/recsyslab
MODEL_RUN=artifacts/phase2-1m
REPORTS_DIR=reports
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Phase 5: off unless an immutable registered key is explicitly selected.
ACTIVE_EXPERIMENT=
# Operator analysis endpoint is disabled if unset. Use a long random value; never commit it.
EXPERIMENT_ADMIN_TOKEN=

# Phase 6: optional verified startup selection. When set, takes precedence over MODEL_RUN.
RELEASE_ROOT=
# /api/metrics is disabled until one of these is configured. File takes precedence.
METRICS_TOKEN=
METRICS_TOKEN_FILE=
MLFLOW_TRACKING_URI=sqlite:///artifacts/mlflow.db
