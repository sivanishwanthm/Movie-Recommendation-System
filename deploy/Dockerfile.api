FROM python:3.11.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MPLCONFIGDIR=/tmp/matplotlib
WORKDIR /app
COPY pyproject.toml README.md requirements-serving-lock.txt ./
COPY src ./src
RUN pip install --no-cache-dir -r requirements-serving-lock.txt && pip install --no-cache-dir . --no-deps && useradd --uid 10001 --create-home recsyslab
COPY configs ./configs
COPY reports ./reports
COPY scripts ./scripts
USER 10001
EXPOSE 8000
CMD ["uvicorn", "recsyslab.serving.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
